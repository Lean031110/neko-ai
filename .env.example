# ========================================
# NEKO AI — Variables de entorno
# ========================================
# Copia este archivo a .env.local y rellena los valores
# cp .env.example .env.local

# ---------- Groq (Fase 1) ----------
# Obtén tu API key gratuita en https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_api_key_aqui

# Modelo a usar (ver https://console.groq.com/docs/models)
# Recomendado: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- Neko: configuración de voz ----------
# Idioma para SpeechRecognition y SpeechSynthesis
# Esta variable se expone al cliente (NEXT_PUBLIC_*) porque el navegador la necesita
NEXT_PUBLIC_NEKO_LANG=es-ES

# Velocidad de síntesis de voz (1.0 = normal, 1.05 un poco más rápida)
NEXT_PUBLIC_NEKO_SPEAK_RATE=1.05

# Tono de síntesis de voz (1.0 = normal)
NEXT_PUBLIC_NEKO_SPEAK_PITCH=1.0

# (Opcional) voiceURI específico de la voz preferida.
# Si se deja vacío, Neko elegirá automáticamente la mejor voz en español disponible.
# Para ver las voces disponibles, abre la consola del navegador y ejecuta:
#   speechSynthesis.getVoices().map(v => ({name: v.name, uri: v.voiceURI, lang: v.lang}))
NEXT_PUBLIC_NEKO_VOICE_URI=

# ---------- Proveedor de LLM (futuro) ----------
# groq | ollama  (Fase 6)
LLM_PROVIDER=groq

# ---------- Ollama (Fase 6, opcional) ----------
# URL de tu instancia local de Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
